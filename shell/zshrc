# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Theme (overridden by Starship below, but still loads OMZ plugins/completions)
ZSH_THEME="robbyrussell"

# Plugins
plugins=(git)

source $ZSH/oh-my-zsh.sh

# Language environment
export LANG=en_US.UTF-8

# PATH: Homebrew (must come early)
export PATH="/opt/homebrew/bin:$PATH"

# PATH: VS Code CLI
export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"

# PATH: Apache Maven
export M2_HOME="$HOME/Software/apache-maven-3.9.0"
export PATH="${M2_HOME}/bin:${PATH}"

# PATH: Local bin
export PATH="$HOME/.local/bin:$PATH"

# PATH: Antigravity
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# OpenSSL (Homebrew)
export OPENSSL_ROOT_DIR=/opt/homebrew/opt/openssl@3

# C/C++ compilers (Homebrew GCC)
export CC=/opt/homebrew/bin/gcc-15
export CXX=/opt/homebrew/bin/g++-15

# conda initialize
__conda_setup="$("$HOME/miniconda3/bin/conda" 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
        . "$HOME/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="$HOME/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Google Cloud SDK
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi

# OpenClaw completions
if [ -f "$HOME/.openclaw/completions/openclaw.zsh" ]; then
    source "$HOME/.openclaw/completions/openclaw.zsh"
fi

# zsh-syntax-highlighting (Catppuccin Macchiato)
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
ZSH_HIGHLIGHT_STYLES[command]='fg=#a6da95'           # Green  - valid commands
ZSH_HIGHLIGHT_STYLES[alias]='fg=#a6da95'             # Green  - aliases
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#8aadf4'           # Blue   - builtins
ZSH_HIGHLIGHT_STYLES[function]='fg=#8aadf4'          # Blue   - functions
ZSH_HIGHLIGHT_STYLES[path]='fg=#cad3f5,underline'    # Text   - paths
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#ed8796'     # Red    - unknown/errors
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#eed49f'  # Yellow - strings
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#eed49f'  # Yellow - strings
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg=#f5a97f'  # Peach  - $'...'
ZSH_HIGHLIGHT_STYLES[comment]='fg=#6e738d'           # Overlay0 - comments
ZSH_HIGHLIGHT_STYLES[option]='fg=#c6a0f6'            # Mauve  - flags/options
ZSH_HIGHLIGHT_STYLES[redirection]='fg=#91d7e3'       # Sky    - redirects
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=#f5bde6'  # Pink   - ; | &&

# zsh-autosuggestions
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6e738d'         # Overlay0 - subtle gray

# Starship prompt
eval "$(starship init zsh)"

# Machine-local overrides (not tracked in git)
# Create ~/.zshrc.local for machine-specific env vars, secrets, etc.
if [ -f "$HOME/.zshrc.local" ]; then
    source "$HOME/.zshrc.local"
fi
